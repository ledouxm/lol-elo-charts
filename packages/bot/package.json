{
    "name": "@lol-elo-charts/bot",
    "version": "0.0.1",
    "type": "module",
    "main": "dist/main.js",
    "exports": {
        ".": "./dist/main.js"
    },
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "node --experimental-strip-types src/main.ts",
        "start": "node dist/main.js",
        "build": "tsup src/main.ts --format esm --dts",
        "typecheck": "tsc --noEmit",
        "migration:create": "drizzle-kit generate",
        "migration:up": "drizzle-kit migrate",
        "drizzle": "drizzle-kit"
    },
    "dependencies": {
        "@effect/platform": "^0.96.1",
        "@effect/platform-node": "^0.106.0",
        "@effect/sql": "^0.51.1",
        "@effect/sql-kysely": "^0.47.0",
        "@effect/sql-pg": "^0.52.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.32.2",
        "effect": "^3.21.2",
        "galeforce": "^0.6.1",
        "kysely": "^0.28.2",
        "pg": "^8.21.0",
        "twisted": "^1.73.0",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^0.23.2",
        "tsup": "^8.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.5.0"
    }
}

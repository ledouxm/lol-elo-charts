        "pg": "^8.21.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^0.19.13",
        "tsup": "^8.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.5.0"
    }
}
